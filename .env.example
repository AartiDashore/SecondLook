# Copy to .env and fill in. Never commit real keys.
ANTHROPIC_API_KEY=your-claude-api-key
SUPABASE_URL=your-supabase-project-url
SUPABASE_KEY=your-supabase-service-role-key
# Optional: live carrier lookup for the phone number scan (line type such as Google Voice,
# current carrier, registered caller ID name). From console.twilio.com.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Optional model overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_FALLBACK_MODEL=claude-sonnet-5-5
